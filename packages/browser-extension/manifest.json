{
  "manifest_version": 3,
  "name": "AionUi Browser Bridge",
  "description": "Lets your AionUi agents use the tabs you share, with your logins. Nothing is shared until you share a tab.",
  "version": "0.1.1",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["debugger", "tabs", "storage", "alarms", "declarativeNetRequest"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AionUi",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  }
}
