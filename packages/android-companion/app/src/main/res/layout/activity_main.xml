<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <!-- Not paired yet -->
        <LinearLayout
            android:id="@+id/pair_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pair_title"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="@string/pair_hint"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pair_scan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pair_scan" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/pair_host">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/pair_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/pair_code">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/pair_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters|textNoSuggestions" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pair_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/pair_button" />
        </LinearLayout>

        <!-- Paired -->
        <LinearLayout
            android:id="@+id/session_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/paired_with"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/agent_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/switch_label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/switch_hint"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <TextView
                android:id="@+id/capture_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/capture_on"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/session_start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/session_start" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/session_stop"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/session_stop" />
            </LinearLayout>

            <TextView
                android:id="@+id/consent_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/session_consent_hint"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <!-- App updates -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/update_title"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/update_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/update_mode_auto"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/update_auto" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/update_mode_ask"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/update_ask" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/update_mode_off"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/update_off" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/update_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/update_check"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/update_check" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/update_install"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/update_install"
                    android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/unpair"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/unpair" />
        </LinearLayout>

        <!-- Permissions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/check_title"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <LinearLayout style="@style/CheckRow">
            <TextView style="@style/CheckLabel" android:text="@string/check_accessibility" />
            <TextView android:id="@+id/accessibility_state" style="@style/CheckState" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_accessibility"
                style="@style/CheckButton"
                android:text="@string/check_open" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/check_accessibility_hint"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/open_app_info"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/check_app_info" />

        <LinearLayout style="@style/CheckRow">
            <TextView style="@style/CheckLabel" android:text="@string/check_overlay" />
            <TextView android:id="@+id/overlay_state" style="@style/CheckState" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_overlay"
                style="@style/CheckButton"
                android:text="@string/check_open" />
        </LinearLayout>

        <LinearLayout style="@style/CheckRow">
            <TextView style="@style/CheckLabel" android:text="@string/check_notifications" />
            <TextView android:id="@+id/notifications_state" style="@style/CheckState" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_notifications"
                style="@style/CheckButton"
                android:text="@string/check_open" />
        </LinearLayout>

        <LinearLayout style="@style/CheckRow">
            <TextView style="@style/CheckLabel" android:text="@string/check_install" />
            <TextView android:id="@+id/install_state" style="@style/CheckState" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_install"
                style="@style/CheckButton"
                android:text="@string/check_open" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/check_install_hint"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <LinearLayout style="@style/CheckRow">
            <TextView style="@style/CheckLabel" android:text="@string/check_battery" />
            <TextView android:id="@+id/battery_state" style="@style/CheckState" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_battery"
                style="@style/CheckButton"
                android:text="@string/check_open" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/check_battery_hint"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>
</ScrollView>
